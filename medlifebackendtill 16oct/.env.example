# # Copy this file to .env (same folder as manage.py) and fill in real values. Never commit .env.
# # Same variable names as .env; see docs/ENV_GUIDE.md for what each one does.

# # Django
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# # newly added
# # Production must use a dedicated key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_ENCRYPTION_KEY=


# # PostgreSQL only
# POSTGRES_DB=medlife
# POSTGRES_USER=medlife_user
# POSTGRES_PASSWORD=change-this-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433

# DATABASE_URL=
# # Alternatively set DATABASE_URL=postgresql://medlife_user:password@127.0.0.1:5432/medlife

# # Comma-separated frontend origins
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# # AI provider selection: mock | ollama | openai | openai_compatible
# # Local Llama 3.1 8B through Ollama (no API key required)
# AI_PROVIDER=ollama
# AI_API_KEY=
# AI_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434


# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_TIMEOUT_SECONDS=120


# # For hosted OpenAI-compatible providers, set AI_PROVIDER=openai_compatible,
# # AI_API_KEY=<secret>, and AI_BASE_URL to the provider's full chat-completions URL.
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
# AI_TIMEOUT_SECONDS=120
# AI_RATE_LIMIT_PER_MINUTE=10

# # ---- OPTIONAL settings added in this version (your existing .env works without them) ----
# # Rate limit for /signup and /signin (per client IP)
# AUTH_RATE_LIMIT=10/min
# # Number of reverse proxies in front of Django (0 = none / local development)
# NUM_PROXIES=0
# # Production only: shared cache for rate limits when running several workers
# REDIS_URL=
# # Production only: true if nginx/load balancer terminates HTTPS and sets X-Forwarded-Proto
# BEHIND_PROXY=false
# # Production only: https origins allowed to POST to /admin/ (e.g. https://api.example.com)
# CSRF_TRUSTED_ORIGINS=
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=0


# # Image-to-text (OCR) for medicine labels / prescriptions. All optional.
# # Needs the Tesseract program installed on the machine (see README step 2b / docs/OCR.md).
# # TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGES=eng
# OCR_MAX_UPLOAD_MB=5
# OCR_MAX_IMAGE_PIXELS=25000000
# OCR_MIN_CONFIDENCE=65
# OCR_TIMEOUT_SECONDS=30

# # ---- Forgot password / email (all optional for startup; password reset emails need EMAIL_* to be set) ----
# # Development: print emails (including the reset link) in the terminal instead of sending. NEVER use in production.
# # EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# # Production / real sending (default backend is SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=// present in the actual env
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# # Use SSL instead of TLS only if your provider requires port 465 (then set EMAIL_USE_TLS=false):
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=//present in the actual env
# # Many providers need an app password / SMTP credential here, not the normal mailbox password.
# EMAIL_HOST_PASSWORD=//present in the actual env
# # The "From" address on the email (must be allowed by your provider), e.g. MedLife <no-reply@yourcompany.com>
# DEFAULT_FROM_EMAIL=
# # Frontend page with the new-password form. Must be https:// in production. The token is added after "#".
# FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# # Seconds a reset link stays valid (300 = 5 minutes)
# PASSWORD_RESET_TIMEOUT=300
# # Reset emails per client IP, and minimum seconds between two emails to the same address
# PASSWORD_RESET_RATE_LIMIT=5/hour
# PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=60







# # ---- Local prescription OCR pipeline ----
# # Default: PaddleOCR detection + TrOCR ONNX transcription + medication structuring.
# # Install the optional stack with: python -m pip install -r requirements/ocr.txt
# OCR_ENGINE=trocr
# # Local PaddleOCR 2.x detection-only model directory (no runtime download).
# PADDLEOCR_DET_MODEL_DIR=
# # Local TrOCR ONNX export directory containing config, processor/tokenizer files and ONNX encoder/decoder.
# TROCR_MODEL_DIR=
# TROCR_MAX_NEW_TOKENS=128
# TROCR_NUM_BEAMS=1
# # Optional custom dictionary path; default is apps/documents/data/drugs.txt.
# # PRESCRIPTION_DRUGS_FILE=
# # Legacy alternative only: OCR_ENGINE=tesseract (requires Tesseract binary).







# GOOGLE_CLIENT_ID=//present in actual env


# # Frontend page for email-based lost-authenticator recovery (token is appended after #).
# FRONTEND_TOTP_RECOVERY_URL=http://localhost:5173/recover-totp

# # # ---- Doctor consultation system ----
# # # Comma-separated existing MedLife account emails allowed to invite doctors and review applications.
# # # The accounts must already exist and authenticate normally; never accept these roles from public signup.
# # # MEDLIFE_SUPER_ADMIN_EMAILS=
# # # MEDLIFE_DOCTOR_REVIEWER_EMAILS=
# # FRONTEND_DOCTOR_INVITATION_URL=http://localhost:5173/doctor-invitation




# # ---- Doctor consultation system ----
# # The Super Admin is provisioned from an existing account with:
# # python manage.py provision_super_admin <existing-account-email>
# # Do not configure Super Admins or reviewer privileges through email allowlists.
# FRONTEND_DOCTOR_INVITATION_URL=http://localhost:5173/doctor-invitation

# # Frontend route used for setting a password after doctor application approval
# FRONTEND_DOCTOR_ACTIVATION_URL=http://localhost:5173/doctor-activate


# # ---- AI provider choices shown in the frontend ----
# # API keys stay on the backend; never put them in Vite/frontend environment variables.
# # The frontend can GET /medlife/ai/providers/ to list configured providers and local models.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# # Alternative alias accepted: CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-5-haiku-20241022
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# # Alternative legacy alias accepted: AI_API_KEY=
# # Local Ollama server and the comma-separated models offered in the frontend selector.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODELS=llama3.1:8b
# AI_TIMEOUT_SECONDS=120
# AI_RATE_LIMIT_PER_MINUTE=10
# # AI_PROVIDER is the legacy/default selection only. A request may explicitly choose
# # gemini, claude, openai, or local; provider credentials are always read server-side.
# AI_PROVIDER=mock















# # ============================================================
# # MedLife Backend - Environment Configuration Example
# # ============================================================
# # Copy this file to .env in the same directory as manage.py.
# # Fill in the real values where required.
# # Never commit .env or expose API keys, passwords, or secret keys.
# # See docs/ENV_GUIDE.md for details about each setting.


# # ============================================================
# # 1. DJANGO SETTINGS
# # ============================================================

# # Generate a secure random key before production deployment.
# # Example: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# # Use true for local development only; set false in production.
# DJANGO_DEBUG=true

# # Comma-separated hostnames allowed to access Django.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# # ============================================================
# # 2. TOTP / AUTHENTICATOR ENCRYPTION
# # ============================================================

# # Required if the backend encrypts TOTP secrets using Fernet.
# # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# # Write the generated key here if TOTP encryption is enabled.
# # Keep this key secret and persistent; changing it may invalidate encrypted data.
# TOTP_ENCRYPTION_KEY=


# # ============================================================
# # 3. DATABASE - POSTGRESQL
# # ============================================================

# POSTGRES_DB=medlife
# POSTGRES_USER=medlife_user
# POSTGRES_PASSWORD=change-this-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433

# # Optional alternative: use DATABASE_URL instead of individual PostgreSQL settings.
# # Example: postgresql://medlife_user:your-password@127.0.0.1:5432/medlife
# # Leave blank when using the individual POSTGRES_* settings.
# DATABASE_URL=


# # ============================================================
# # 4. FRONTEND / CORS / CSRF
# # ============================================================

# # Comma-separated frontend origins allowed to make cross-origin requests.
# # Update these values if your frontend runs on a different port or domain.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# # Production only: HTTPS origins allowed to submit requests protected by CSRF.
# # Add your actual backend/admin origin if required, for example:
# # CSRF_TRUSTED_ORIGINS=https://api.example.com
# CSRF_TRUSTED_ORIGINS=


# # ============================================================
# # 5. SECURITY / RATE LIMITING / PROXY
# # ============================================================

# # Rate limit for signup and signin requests, subject to backend implementation.
# AUTH_RATE_LIMIT=10/min

# # Number of trusted reverse proxies in front of Django.
# # Use 0 for local development. Configure carefully in production.
# NUM_PROXIES=0

# # Optional production cache for shared rate limits across multiple workers.
# # Configure this if Redis is installed and supported by the backend.
# REDIS_URL=

# # Set true only when a trusted reverse proxy terminates HTTPS and forwards
# # the correct X-Forwarded-Proto header.
# BEHIND_PROXY=false

# # Enable HTTPS redirection in production. For local HTTP development,
# # set false if this setting causes redirects away from localhost.
# SECURE_SSL_REDIRECT=false

# # Production only: HSTS duration in seconds. Increase only after HTTPS works.
# # Example: 31536000 for one year.
# SECURE_HSTS_SECONDS=0


# # ============================================================
# # 6. AI PROVIDER - DEFAULT BACKEND CONFIGURATION
# # ============================================================

# # Choose the default provider supported by the current backend:
# # mock | ollama | openai | openai_compatible
# #
# # Local development using Ollama does not require a cloud API key.
# # Keep AI_PROVIDER=ollama while using your local Ollama installation.
# AI_PROVIDER=ollama

# # Legacy/general AI credentials and model settings used by some implementations.
# # Fill in AI_API_KEY only if the selected provider requires it and your backend
# # reads this variable.
# AI_API_KEY=
# AI_MODEL=llama3.1:8b

# # Ollama must be installed and running locally or at the configured server URL.
# # Example: ollama pull llama3.1:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# # Comma-separated local Ollama models available to the application.
# # Make sure each model is downloaded in Ollama before selecting it.
# OLLAMA_MODELS=llama3.1:8b

# # Full chat-completions URL for an OpenAI-compatible service.
# # Keep the OpenAI URL for OpenAI-compatible APIs; change it if your provider
# # supplies a different endpoint. This is not required for ordinary local Ollama.
# AI_BASE_URL=https://api.openai.com/v1/chat/completions

# # Maximum time the backend waits for an AI response, in seconds.
# AI_TIMEOUT_SECONDS=120

# # Maximum AI requests allowed per minute, subject to backend implementation.
# AI_RATE_LIMIT_PER_MINUTE=10


# # ============================================================
# # 7. OPTIONAL CLOUD AI PROVIDERS
# # ============================================================
# # Leave provider keys blank when they are not available.
# # Add company-provided keys here when available.
# # Keep all API keys in the backend .env, NEVER in frontend Vite variables.
# #
# # Note: provider selection and environment variable names must match the
# # backend implementation. Adding a key here alone does not integrate a provider.


# # ---- Google Gemini ----
# # Write the Google Gemini API key here if available.
# # Obtain it from Google AI Studio: https://aistudio.google.com/
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash


# # ---- Anthropic Claude ----
# # Write the Anthropic API key here if available.
# # Obtain it from Anthropic's official developer console.
# ANTHROPIC_API_KEY=

# # Optional alias for implementations that read CLAUDE_API_KEY instead.
# CLAUDE_API_KEY=

# CLAUDE_MODEL=claude-3-5-haiku-20241022


# # ---- OpenAI / ChatGPT API ----
# # Write the OpenAI API key here if available.
# # Obtain it from the OpenAI API platform. ChatGPT subscriptions and API billing
# # are separate; a ChatGPT subscription does not automatically provide API credit.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# # Optional legacy alias for implementations that read AI_API_KEY instead.
# # Do not copy an OpenAI key here unless the backend expects this variable.
# # AI_API_KEY is already declared in the default AI section above.


# # ============================================================
# # 8. EMAIL / FORGOT-PASSWORD
# # ============================================================

# # Optional during startup; required for sending real password-reset emails.
# # For local testing only, you can use the console backend to print emails
# # and reset links in the Django terminal. Never use it in production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# # Enter your actual SMTP host if email sending is enabled.
# # Example: smtp.yourcompany.com
# EMAIL_HOST=

# # Use port 587 with TLS for most SMTP configurations.
# # Use port 465 with SSL only if your provider specifically requires it.
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# # Enter your company email account / SMTP username if available.
# EMAIL_HOST_USER=

# # Enter the SMTP password or app-specific SMTP credential if required.
# # Some providers do not allow your normal mailbox password.
# EMAIL_HOST_PASSWORD=

# # Enter a sender address permitted by your SMTP provider.
# # Example: MedLife <no-reply@yourcompany.com>
# DEFAULT_FROM_EMAIL=

# # Frontend route that handles password-reset tokens.
# # The token is appended after the URL fragment (#).
# # Replace localhost with your production frontend URL during deployment.
# FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# # Reset-link validity in seconds. 300 = 5 minutes.
# PASSWORD_RESET_TIMEOUT=300

# # Password-reset email rate limit and cooldown, subject to backend implementation.
# PASSWORD_RESET_RATE_LIMIT=5/hour
# PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=60


# # ============================================================
# # 9. GOOGLE SIGN-IN
# # ============================================================

# # Write your Google OAuth Web Client ID here if Google sign-in is configured.
# # Leave blank if Google sign-in is not being used.
# # Create/manage credentials in Google Cloud Console.
# GOOGLE_CLIENT_ID=


# # ============================================================
# # 10. LOST AUTHENTICATOR / TOTP RECOVERY
# # ============================================================

# # Frontend route for email-based lost-authenticator recovery.
# # The recovery token is appended after the URL fragment (#).
# FRONTEND_TOTP_RECOVERY_URL=http://localhost:5173/recover-totp


# # ============================================================
# # 11. DOCTOR CONSULTATION / INVITATIONS
# # ============================================================

# # Frontend route for accepting a doctor invitation.
# FRONTEND_DOCTOR_INVITATION_URL=http://localhost:5173/doctor-invitation

# # Frontend route for setting a password after doctor application approval.
# FRONTEND_DOCTOR_ACTIVATION_URL=http://localhost:5173/doctor-activate

# # Super Admin accounts should be provisioned using the backend management command.
# # Example: python manage.py provision_super_admin existing-account@example.com
# # Do not assign Super Admin privileges through public signup or frontend settings.


# # ============================================================
# # 12. OCR - IMAGE TO TEXT
# # ============================================================

# # General OCR settings. The OCR stack may require optional dependencies.
# # See README and docs/OCR.md for installation instructions.

# # Optional path to the Tesseract executable, if using Tesseract.
# # Example Windows path:
# # TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR_LANGUAGES=eng
# OCR_MAX_UPLOAD_MB=5
# OCR_MAX_IMAGE_PIXELS=25000000
# OCR_MIN_CONFIDENCE=65
# OCR_TIMEOUT_SECONDS=30


# # ============================================================
# # 13. LOCAL PRESCRIPTION OCR PIPELINE
# # ============================================================

# # Select the OCR engine supported by your backend.
# # The configured pipeline may require PaddleOCR and TrOCR ONNX model files.
# # Install optional dependencies with: python -m pip install -r requirements/ocr.txt
# OCR_ENGINE=trocr

# # Set these paths if you have downloaded the relevant model files locally.
# # Leave blank until the models are installed and configured.
# PADDLEOCR_DET_MODEL_DIR=
# TROCR_MODEL_DIR=

# # Maximum number of new tokens generated by TrOCR.
# TROCR_MAX_NEW_TOKENS=128

# # Beam search setting. 1 is a lightweight greedy-decoding configuration.
# TROCR_NUM_BEAMS=1

# # Optional custom medication dictionary.
# # If unset, the backend may use its default dictionary if implemented.
# # PRESCRIPTION_DRUGS_FILE=


# # ============================================================
# # END OF EXAMPLE
# # ============================================================







# ============================================================
# MedLife Backend - Environment Configuration Example
# Copy to .env beside manage.py. Never commit .env or expose its secrets.
# See docs/ENV_GUIDE.md for details.
# ============================================================

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- TOTP encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set this if TOTP encryption is enabled; keep the key persistent and secret.
TOTP_ENCRYPTION_KEY=

# --- PostgreSQL ---
POSTGRES_DB=medlife
POSTGRES_USER=medlife_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Optional alternative to POSTGRES_* settings:
# DATABASE_URL=postgresql://medlife_user:your-password@127.0.0.1:5432/medlife
DATABASE_URL=

# --- Frontend / CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production only; include trusted HTTPS origins when required.
CSRF_TRUSTED_ORIGINS=

# --- Security / rate limits / proxy ---
AUTH_RATE_LIMIT=10/min
# Number of trusted reverse proxies; keep 0 for local development.
NUM_PROXIES=0
# Optional shared cache for rate limits across multiple backend workers.
# Example: REDIS_URL=redis://127.0.0.1:6379/1
REDIS_URL=
# Set true only when a trusted reverse proxy terminates HTTPS and sets X-Forwarded-Proto.
BEHIND_PROXY=false
# For local HTTP development use false; configure HTTPS before enabling in production.
SECURE_SSL_REDIRECT=false
# Set an appropriate positive value only after production HTTPS is verified.
SECURE_HSTS_SECONDS=0

# --- AI provider selection ---
# The default is local Ollama. Users can choose another configured provider in the frontend.
# Supported provider IDs: local (Ollama), gemini, claude, openai; mock is development-only.
AI_PROVIDER=ollama
# Legacy key alias. Prefer OPENAI_API_KEY for OpenAI.
AI_API_KEY=
# Legacy/local model default; also used by older clients.
AI_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Comma-separated Ollama models permitted in the frontend selector.
# Each listed model must already be installed in Ollama.
OLLAMA_MODELS=llama3.1:8b
# Full chat-completions URL for OpenAI-compatible endpoints; keep this server-controlled.
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_TIMEOUT_SECONDS=120
AI_RATE_LIMIT_PER_MINUTE=10

# API keys stay on the backend; NEVER place these in Vite/frontend environment variables.
# Leave each key blank until your company provides it. A key alone does not guarantee access;
# the provider must be enabled for your account and configured in the backend.
# Google Gemini API key (if available): https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional comma-separated allowlist of models; defaults to GEMINI_MODEL.
GEMINI_MODELS=gemini-2.0-flash

# Anthropic Claude API key (if available): use your organization's Anthropic console.
ANTHROPIC_API_KEY=
# Alternative alias accepted by the backend if your company provides this variable name.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022
# Optional comma-separated allowlist of models; defaults to CLAUDE_MODEL.
CLAUDE_MODELS=claude-3-5-haiku-20241022

# OpenAI API key (if available): https://platform.openai.com/api-keys
# ChatGPT subscriptions and API billing are separate.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated allowlist of models; defaults to OPENAI_MODEL.
OPENAI_MODELS=gpt-4o-mini

# --- Email / forgot password ---
# For local-only testing, uncomment the console backend below to print reset emails in the terminal.
# Never use the console backend in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Enter your actual company SMTP host if email sending is enabled.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
# Use SSL only if your provider requires port 465; then set TLS=false.
EMAIL_USE_SSL=false
# Write the company SMTP username here if available.
EMAIL_HOST_USER=
# Write the SMTP password/app password here if available; do not use a placeholder.
EMAIL_HOST_PASSWORD=
# Sender address permitted by your SMTP provider, e.g. MedLife <no-reply@yourcompany.com>
DEFAULT_FROM_EMAIL=
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Reset-link validity in seconds (300 = 5 minutes).
PASSWORD_RESET_TIMEOUT=300
PASSWORD_RESET_RATE_LIMIT=5/hour
PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=60

# --- Google sign-in ---
# Write the Google OAuth Web Client ID here if Google sign-in is configured.
GOOGLE_CLIENT_ID=

# --- Lost authenticator recovery ---
FRONTEND_TOTP_RECOVERY_URL=http://localhost:5173/recover-totp

# --- Doctor consultation / invitations ---
FRONTEND_DOCTOR_INVITATION_URL=http://localhost:5173/doctor-invitation
FRONTEND_DOCTOR_ACTIVATION_URL=http://localhost:5173/doctor-activate
# Provision Super Admins using the backend command, not public signup:
# python manage.py provision_super_admin existing-account@example.com

# --- General OCR ---
# Optional Tesseract binary path if using the Tesseract engine.
# Windows example: TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
OCR_LANGUAGES=eng
OCR_MAX_UPLOAD_MB=5
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MIN_CONFIDENCE=65
OCR_TIMEOUT_SECONDS=30

# --- Local prescription OCR pipeline ---
# Optional stack: python -m pip install -r requirements/ocr.txt
# Configure these local model directories after downloading the model files.
OCR_ENGINE=trocr
PADDLEOCR_DET_MODEL_DIR=
TROCR_MODEL_DIR=
TROCR_MAX_NEW_TOKENS=128
TROCR_NUM_BEAMS=1
# Optional custom medication dictionary:
# PRESCRIPTION_DRUGS_FILE=
